{
  "name": "@inneranimalmedia/agentsam-theme-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Customer-neutral source intelligence and transformation tools for themes",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "cli": "node packages/theme-cli/bin/agentsam-theme.mjs",
    "verify": "npm test && node scripts/verify-distribution.mjs",
    "test:rust": "cargo test --locked --manifest-path rust/theme-rewriter-lab/Cargo.toml",
    "check:rust": "cargo check --locked --target wasm32-unknown-unknown --manifest-path rust/theme-rewriter-lab/Cargo.toml",
    "smoke:rust": "node scripts/smoke-rust-rewriter.mjs"
  },
  "devDependencies": {
    "yazl": "^3.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
